.DS_Store
# Windows Explorer thumbnail caches. Kenney's zips ship these; they are not art.
Thumbs.db
node_modules/
*.log
.env

# build output
dist/
.vite/
*.tsbuildinfo

# test / tooling artifacts
coverage/
test-results/
playwright-report/

# dev output (screenshots, sim dumps)
artifacts/

# scratch dump scripts used while cross-checking a port against the TS oracle
.tmpdump/
# THE LOADOUT SWEEP'S OUTPUT. Megabytes of measurement that is only true of the catalog it was
# taken against - see sweep.bat. Committing it would mean a diff of over a thousand changed numbers
# every time a weapon moves, and a reader trusting a page that a later balance change had already
# invalidated. Re-run `sweep --fresh` instead - `sweep --mini` for a few minutes, the full `sweep`
# for the real thing (user-initiated only, see CLAUDE.md).
sweep/

# Generated SFX takes - four per sound, regenerable and not small.
sfx/takes/
sfx/sfx-picks.json

# Loop-seam audition files - scratch, regenerated by sfx/loop.mjs on demand.
public/music/**/*.seamtest.mp3
